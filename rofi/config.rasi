@import "colors.rasi"

configuration {
    display-drun:   "Apps";
    display-run:    "Run";
    display-window: "Windows";
    show-icons:     true;
}

* {
    font:             "JetBrainsMono Nerd Font 12";
    background-color: transparent;
    text-color:       @fg;
    border-color:     transparent;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

window {
    background-color: @bg-rgba;
    border:           1px;
    border-color:     rgba(255,255,255,0.12);
    border-radius:    10px;
    width:            520px;
    location:         center;
    y-offset:         -120px;
}

inputbar {
    background-color: rgba(255,255,255,0.05);
    border:           0px 0px 1px 0px;
    border-color:     rgba(255,255,255,0.10);
    border-radius:    10px 10px 0px 0px;
    padding:          10px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @accent;
    font:       "JetBrainsMono Nerd Font Bold 12";
}

entry {
    placeholder:       "search...";
    placeholder-color: @dim;
    cursor:            text;
}

listview {
    background-color: transparent;
    lines:            8;
    columns:          1;
    fixed-height:     false;
    padding:          6px;
    spacing:          2px;
}

element {
    background-color: transparent;
    border-radius:    6px;
    padding:          8px 10px;
    spacing:          10px;
    cursor:           pointer;
}

element normal normal   { background-color: transparent;              text-color: @fg; }
element normal urgent   { background-color: transparent;              text-color: @warn; }
element normal active   { background-color: transparent;              text-color: @accent; }

element alternate normal { background-color: rgba(255,255,255,0.03); text-color: @fg; }
element alternate urgent { background-color: rgba(255,255,255,0.03); text-color: @warn; }
element alternate active { background-color: rgba(255,255,255,0.03); text-color: @accent; }

element selected normal {
    background-color: @accent;
    text-color:       #ffffff;
}

element selected urgent {
    background-color: @warn;
    text-color:       #ffffff;
}

element selected active {
    background-color: @accent;
    text-color:       #ffffff;
}

element-icon {
    size:           1.1em;
    vertical-align: 0.5;
}

element-text {
    text-color:     inherit;
    vertical-align: 0.5;
}

scrollbar {
    handle-color: @dim;
    handle-width: 4px;
    width:        6px;
    border:       0px;
    padding:      0px 2px;
}

message {
    padding:          8px 14px;
    border:           1px 0px 0px 0px;
    border-color:     rgba(255,255,255,0.08);
    background-color: rgba(255,255,255,0.04);
}

textbox {
    text-color: @dim;
}
