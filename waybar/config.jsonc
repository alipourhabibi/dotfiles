// -*- mode: jsonc -*-
{
    "position": "bottom",
    "height": 40,
    "spacing": 2,
    "layer": "top",

    "modules-left": [
        "niri/workspaces"
    ],
    "modules-center": [
        "clock#time",
        "clock#date"
    ],
    "modules-right": [
        "custom/temp",
        "cpu",
        "memory",
        "custom/storage-root",
        "network",
        "pulseaudio",
        "battery",
        "custom/dnd",
        "tray",
        "custom/power"
    ],

    "niri/workspaces": {
        "format": "{index}",
        "on-click": "activate",
        "on-scroll-up": "niri msg action focus-workspace-up",
        "on-scroll-down": "niri msg action focus-workspace-down"
    },

    "clock#time": {
        "format": "{:%H:%M}",
        "interval": 1,
        "tooltip": false
    },

    "clock#date": {
        "format": "{:%d %b}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "custom/temp": {
        "exec": "sensors coretemp-isa-0000 | awk '/Package id 0/ {gsub(/[+°C]/,\"\",$4); print $4}'",
        "format": "󰔏 {}°",
        "interval": 5,
        "tooltip": false
    },

    "custom/dnd": {
        "exec": "~/.config/waybar/modules/dnd.sh",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "makoctl mode -t do-not-disturb >/dev/null; pkill -RTMIN+8 waybar"
    },

    "custom/storage-root": {
        "format": "󰋊 {}",
        "return-type": "json",
        "interval": 60,
        "exec": "~/.config/waybar/modules/storage-root.sh"
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 5,
        "tooltip": false
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 --",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋎",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "scroll-step": 5
    },

    "memory": {
        "format": "󰍛 {avail:.0f}G",
        "interval": 3
    },

    "network": {
        "interface": "wlo1",
        "format-wifi": "󰖩 {bandwidthDownBytes}",
        "format-ethernet": "󰈀 {bandwidthDownBytes}",
        "format-disconnected": "󰖪 off",
        "tooltip-format": "{ifname}: {ipaddr} ({essid})",
        "interval": 3
    },

    "battery": {
        "bat": "BAT0",
        "adapter": "AC",
        "full-at": 98,
        "states": {
            "warning": 20,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-full": "󰁹 {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "poll-interval": 1
    },

    "tray": {
        "spacing": 6
    },

    "custom/power": {
        "format": "⏻",
        "on-click": "wlogout",
        "tooltip": false
    }
}
