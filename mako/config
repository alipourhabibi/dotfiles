font=JetBrainsMono Nerd Font 12
background-color=#0d0d0deb
text-color=#FDFDFD
border-color=#014E71
border-radius=10
border-size=1
width=360
height=200
margin=12
padding=14
icons=1
max-icon-size=48
icon-path=/usr/share/icons/Papirus-Dark:/usr/share/icons/hicolor
sort=-time
layer=overlay
anchor=top-right

[urgency=low]
border-color=#014E71
default-timeout=4000

[urgency=normal]
border-color=#014E71
default-timeout=6000

[urgency=high]
border-color=#f87171
text-color=#f87171
background-color=#1a0000eb
default-timeout=0

[app-name=volume-osd]
anchor=top-center
border-color=#014E71
width=340
margin=16
default-timeout=1500

[app-name=brightness-osd]
anchor=top-center
border-color=#fbbf24
width=340
margin=16
default-timeout=1500
