font=JetBrainsMono Nerd Font 12
background-color=#090f10ea
text-color=#dee4e4
border-color=#81d3df
border-radius=10
border-size=1
width=360
height=200
margin=12
padding=14
icons=1
max-icon-size=48
icon-path=/usr/share/icons/Papirus-Dark:/usr/share/icons/hicolor
sort=-time
layer=overlay
anchor=top-right

[urgency=low]
border-color=#81d3df
default-timeout=4000

[urgency=normal]
border-color=#81d3df
default-timeout=6000

[urgency=high]
border-color=#ffb4ab
text-color=#ffb4ab
background-color=#262222ea
default-timeout=0

[app-name=volume-osd]
anchor=top-center
border-color=#81d3df
width=340
margin=16
default-timeout=1500

[app-name=brightness-osd]
anchor=top-center
border-color=#b9c6ea
width=340
margin=16
default-timeout=1500
