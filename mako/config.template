font=JetBrainsMono Nerd Font 12
background-color=__C_BG_MAKO__
text-color=__C_FG__
border-color=__C_ACCENT__
border-radius=10
border-size=1
width=360
height=200
margin=12
padding=14
icons=1
max-icon-size=48
icon-path=/usr/share/icons/Papirus-Dark:/usr/share/icons/hicolor
sort=-time
layer=overlay
anchor=top-right

[urgency=low]
border-color=__C_ACCENT__
default-timeout=4000

[urgency=normal]
border-color=__C_ACCENT__
default-timeout=6000

[urgency=high]
border-color=__C_CRIT__
text-color=__C_CRIT__
background-color=__C_CRIT_BG_MAKO__
default-timeout=0

[app-name=volume-osd]
anchor=top-center
border-color=__C_ACCENT__
width=340
margin=16
default-timeout=1500

[app-name=brightness-osd]
anchor=top-center
border-color=__C_WARN__
width=340
margin=16
default-timeout=1500
